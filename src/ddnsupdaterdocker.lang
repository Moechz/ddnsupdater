# ===========================================================================
# Multilingual file for the TOS 7 Docker application "ddnsupdaterdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "DDNS Updater"
auth         = "qdm12"
version      = "@@VERSION@@"
descript     = "DDNS Updater keeps DNS records for your domain in sync with your dynamic public IP. It supports dozens of providers (Cloudflare, DuckDNS, Namecheap, Route 53 and more), stores its configuration as JSON and exposes a small web UI for status."
release_note = "1. First release."
important    = "Open the web UI on port 8000 to see the current status; the configuration file lives in /Volume1/DockerAppData/ddnsupdaterdocker/data/config.json and can be edited there. Data survives restarts and updates. The container runs as uid 1000. Needs DockerEngine and outbound HTTPS to your DNS provider; configure a registry mirror if Docker Hub is unreachable. Back up the data folder before uninstalling with data removal. Plain HTTP on the LAN."

[zh-cn]
name         = "DDNS Updater"
auth         = "qdm12"
version      = "@@VERSION@@"
descript     = "多供应商动态 DNS 更新器，配置简单。"
release_note = "1. First release."
important    = "首次使用请打开网页完成初始化。数据保存在 DockerAppData/ddnsupdaterdocker，重启和升级不会丢失。容器以 uid 1000 运行，挂载目录需对该用户可读。需要 DockerEngine；Docker Hub 不可达时先配置镜像加速。卸载并删除数据前请备份。局域网内为 HTTP。"

